# ==========================================
# Create Rota — Environment Variables Example
# Copy to .env for local development
# ==========================================

# Backend Settings
PROJECT_NAME="Create Rota"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Secret Key (minimum 32 characters in production)
SECRET_KEY="dev-insecure-secret-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Local Docker Postgres: postgresql+psycopg://create_rota:create_rota_dev_pw@localhost:5432/create_rota_db
# Local SQLite fallback: sqlite+pysqlite:///./create_rota.db
DATABASE_URL="postgresql+psycopg://create_rota:create_rota_dev_pw@localhost:5432/create_rota_db"
DATABASE_URL_TEST="sqlite+pysqlite:///./test_create_rota.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Email Configuration
# Mode: "console" (logs links to terminal in dev), "sink" (in-memory test sink), or "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@createrota.local"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=false

# Frontend Configuration (for apps/web)
VITE_API_URL="http://localhost:8000/api/v1"
